{
  "registryVersion": "1.0",
  "issue": "PSI-43",
  "normativeModel": "docs/efs-v1-capability-contract-model.md",
  "acceptanceCriteria": [
    {
      "id": "PSI43-AC-01",
      "requirement": "Capability IDs are unique within the exact release; duplicate IDs are rejected with stable RFC 6901 diagnostics.",
      "tests": [
        "test_duplicate_capability_ids_are_rejected_with_stable_pointer"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-02",
      "requirement": "Contract error codes are unique within each contract and compared exactly and case-sensitively.",
      "tests": [
        "test_duplicate_contract_error_codes_are_exact_and_case_sensitive"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-03",
      "requirement": "Capability execution-profile references resolve to exactly one profile in the selected execution source.",
      "tests": [
        "test_capability_execution_profile_must_resolve_exactly"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-04",
      "requirement": "Embedded schemas use the local-only EFS reference profile; remote, dynamic and unresolved references fail without network retrieval.",
      "tests": [
        "test_schema_reference_profile_rejects_remote_and_unresolved_refs",
        "test_valid_local_json_pointer_reference_is_accepted",
        "test_definition_reference_graph_resolves_only_prebundled_resources",
        "test_duplicate_schema_resource_ids_are_rejected"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-05",
      "requirement": "Concrete payloads are validated against the exact publisher/factory/release/digest/capability/contract-version coordinate and direction.",
      "tests": [
        "test_payload_validation_uses_exact_release_contract_and_direction",
        "test_payload_validation_supports_only_preloaded_local_resource_graph",
        "test_declared_error_details_are_validated_by_the_contract_error_schema"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-06",
      "requirement": "Payload diagnostics are deterministic, actionable and do not disclose payload values.",
      "tests": [
        "test_payload_validation_uses_exact_release_contract_and_direction"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-07",
      "requirement": "Registry publication rejects an invalid capability contract before digest service, operation reservation or artifact storage.",
      "tests": [
        "test_publication_rejects_invalid_contract_before_digest_storage_or_commit"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    },
    {
      "id": "PSI43-AC-08",
      "requirement": "The existing reportVersion 1.0 structure and stages remain unchanged.",
      "tests": [
        "test_duplicate_capability_ids_are_rejected_with_stable_pointer"
      ],
      "fixtures": [
        "capabilityContractValidation"
      ]
    }
  ]
