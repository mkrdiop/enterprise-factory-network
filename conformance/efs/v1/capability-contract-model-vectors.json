{
  "modelVersion": "1.0",
  "conformanceProfile": "efs-v1",
  "authority": "docs/efs-v1-capability-contract-model.md",
  "identityRules": {
    "capabilityId": {
      "scope": "exact publisher/factory/release coordinate",
      "comparison": "exact-case-sensitive-string",
      "uniqueWithinRelease": true,
      "globalUniqueness": false
    },
    "contractIdentity": {
      "tuple": [
        "contract.id",
        "contract.version"
      ],
      "contractId": "opaque-absolute-uri-no-dereference-no-publisher-uri-canonicalization",
      "contractVersion": "opaque-non-empty-exact-case-sensitive-string",
      "independentOf": [
        "efsVersion",
        "release.version",
        "implementation-build",
        "endpoint-address",
        "execution-profile-version"
      ]
    },
    "executionProfileBinding": {
      "manifestSource": "capability.executionProfiles entries match execution.profiles[].id exactly",
      "externalSource": "capability.executionProfiles entries match execution.profileReferences[].id exactly",
      "implicitFallback": false
    }
  },
  "payloadRules": {
    "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
    "topLevelType": "object",
    "schemaResources": [
      "inputs",
      "outputs",
      "optional error.schema"
    ],
    "referencePolicy": "local immutable schema resource graph only; no network retrieval"
  },
  "errorRules": {
    "codePattern": "^[A-Za-z][A-Za-z0-9._-]{0,127}$",
    "comparison": "exact-case-sensitive",
    "uniqueWithinContract": true,
    "duplicateCodeExpectedDiagnostic": "EFS_CONTRACT_ERROR_CODE_DUPLICATE",
    "optionalSchemaTopLevelType": "object",
    "codeMeaningStableWithinContractVersion": true
  },
  "guaranteeRules": {
    "onlyGovernedVocabularyHasSharedSemantics": true,
    "inferFromOmissionOrMode": false,
    "undeclaredGuarantees": [
      "idempotency",
      "retry-safety",
      "ordering",
      "delivery",
      "consistency",
      "cancellation",
      "approval",
      "compensation",
      "isolation",
      "durability"
    ]
  },
  "interactionModes": {
    "sync": "single request/response interaction",
    "async": "acceptance may precede final result",
    "streaming": "sequence of progress/data events before terminal outcome",
    "event": "interaction initiated or advanced by event occurrence"
  },
  "transportIndependence": {
    "modeIsTransport": false,
    "mandatoryProtocol": null,
    "candidateProtocols": [
      "MCP",
      "A2A",
      "OpenAPI",
      "CloudEvents",
      "HTTP",
      "gRPC",
      "WebSocket",
      "message broker"
    ]
  },
  "examples": [
    {
      "id": "sync",
      "path": "fixtures/valid/capability-contract-sync.json",
      "mode": "sync"
    },
    {
      "id": "async",
      "path": "fixtures/valid/capability-contract-async.json",
      "mode": "async"
    },
    {
      "id": "streaming",
      "path": "fixtures/valid/capability-contract-streaming.json",
      "mode": "streaming"
    },
    {
      "id": "event",
      "path": "fixtures/valid/capability-contract-event.json",
      "mode": "event"
    }
  ],
  "semanticVectors": [
    {
      "id": "capability-id-duplicate-exact",
      "rule": "duplicate capability.id within one exact release is invalid",
      "expected": "reject",
      "diagnostic": "EFS_CAPABILITY_ID_DUPLICATE"
    },
    {
      "id": "capability-id-case-distinct",
      "rule": "capability IDs differing only by case are distinct",
      "expected": "accept"
    },
    {
      "id": "contract-id-not-dereferenced",
      "rule": "contract.id is an opaque identifier and never a retrieval instruction",
      "expected": "no-network-access"
    },
    {
      "id": "contract-version-independent",
      "rule": "contract.version is not inferred from release or build version",
      "expected": "exact-coordinate-required"
    },
    {
      "id": "error-code-duplicate",
      "rule": "duplicate error code in one contract is invalid",
      "expected": "reject",
      "diagnostic": "EFS_CONTRACT_ERROR_CODE_DUPLICATE"
    },
    {
      "id": "error-code-case-sensitive",
      "rule": "error codes are compared exactly and case-sensitively",
      "expected": "accept-distinct-codes"
    },
    {
      "id": "error-schema-object",
      "rule": "optional error.schema has Draft 2020-12 top-level type object",
      "expected": "reject-non-object"
    },
    {
      "id": "execution-profile-unresolved",
      "rule": "capability profile binding must resolve exactly in the selected execution source",
      "expected": "reject",
      "diagnostic": "EFS_CAPABILITY_EXECUTION_PROFILE_UNRESOLVED"
    },
    {
      "id": "mode-does-not-select-transport",
      "rule": "interaction mode does not imply a transport or delivery guarantee",
      "expected": "no-inference"
    },
    {
      "id": "undeclared-guarantee",
      "rule": "omitted guarantee is unsupported/unknown, never implicitly supported",
      "expected": "no-inference"
    }
  ]
}
