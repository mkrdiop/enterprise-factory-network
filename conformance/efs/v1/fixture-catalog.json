{
  "catalogVersion": "1.0",
  "conformanceProfile": "efs-v1",
  "description": "Language-neutral fixture inventory. Every discovered manifest is exercised by the catalog test; raw parser cases are byte-preserving encoded inputs.",
  "manifestGroups": [
    {
      "id": "valid",
      "glob": "fixtures/valid/*.json",
      "expectedValid": true,
      "stage": "all"
    },
    {
      "id": "invalid",
      "glob": "fixtures/invalid/*.json",
      "expectedValid": false,
      "stage": "structural_or_profile"
    },
    {
      "id": "boundary",
      "glob": "fixtures/boundary/*.json",
      "expectedValid": true,
      "stage": "all"
    },
    {
      "id": "extensions",
      "glob": "fixtures/extensions/*.json",
      "expectedValid": true,
      "stage": "all"
    },
    {
      "id": "adversarial-existing",
      "glob": "fixtures/adversarial/*.json",
      "expectedValid": false,
      "stage": "parsing"
    }
  ],
  "rawInputs": [
    {
      "id": "malformed-json",
      "path": "fixtures/adversarial/parser/malformed-json.txt",
      "encoding": "utf-8",
      "expectedCode": "EFS_JSON_INVALID"
    },
    {
      "id": "duplicate-root-member",
      "path": "fixtures/adversarial/parser/duplicate-root.txt",
      "encoding": "utf-8",
      "expectedCode": "EFS_JSON_DUPLICATE_MEMBER"
    },
    {
      "id": "duplicate-nested-member",
      "path": "fixtures/adversarial/parser/duplicate-nested.txt",
      "encoding": "utf-8",
      "expectedCode": "EFS_JSON_DUPLICATE_MEMBER"
    },
    {
      "id": "non-json-constant",
      "path": "fixtures/adversarial/parser/non-json-constant.txt",
      "encoding": "utf-8",
      "expectedCode": "EFS_JSON_INVALID"
    },
    {
      "id": "invalid-utf8",
      "path": "fixtures/adversarial/parser/invalid-utf8.b64",
      "encoding": "base64",
      "expectedCode": "EFS_JSON_INVALID_ENCODING"
    }
  ],
  "publisherIdentity": {
    "vectors": "conformance/efs/v1/publisher-identity-vectors.json",
    "acceptance": "conformance/efs/v1/publisher-identity-acceptance.json",
    "testModule": "tests/test_publisher_identity.py"
  }
}
