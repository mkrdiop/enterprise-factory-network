{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.enterprise-factory.example/efs/v1/conformance-report.schema.json",
  "title": "EFS v1 Conformance Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reportVersion",
    "conformanceProfile",
    "schemaDialect",
    "valid",
    "stages",
    "diagnostics"
  ],
  "properties": {
    "reportVersion": {
      "const": "1.0"
    },
    "conformanceProfile": {
      "const": "efs-v1"
    },
    "schemaDialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "valid": {
      "type": "boolean"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parsing",
        "structural",
        "embedded_schemas",
        "profile"
      ],
      "properties": {
        "parsing": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "structural": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "embedded_schemas": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        },
        "profile": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ]
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "stage",
          "path",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "enum": [
              "parsing",
              "structural",
              "embedded_schemas",
              "profile",
              "internal"
            ]
          },
          "path": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        }
      }
    }
  }
}
