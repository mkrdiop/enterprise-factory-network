{
  "efsVersion": "1.0.0",
  "publisher": {
    "id": "urn:example:publishers:acme",
    "name": "Acme Example"
  },
  "factory": {
    "id": "customer-support",
    "name": "Customer Support Factory"
  },
  "release": {
    "version": "1.2.0",
    "digest": {
      "profile": "efs-jcs-sha256-v1",
      "algorithm": "SHA-256",
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  },
  "capabilities": [
    {
      "id": "answer-customer",
      "name": "Answer customer",
      "contract": {
        "id": "https://schemas.example.org/contracts/customer-answer",
        "version": "1.0.0",
        "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
        "inputs": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            }
          },
          "required": [
            "question"
          ]
        },
        "outputs": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            }
          },
          "required": [
            "answer"
          ]
        },
        "errors": [
          {
            "code": "INVALID_REQUEST",
            "description": "Invalid request"
          }
        ]
      },
      "endpoints": []
    }
  ],
  "execution": {
    "source": "manifest",
    "profiles": [
      {
        "id": "standard",
        "modes": [
          "batch"
        ]
      }
    ]
  },
  "dependencies": [],
  "policies": {
    "declarations": [
      {
        "id": "tenant-access",
        "profile": "https://profiles.example.org/policies/access/v1",
        "version": "1.0.0",
        "content": {
          "mode": "restrictive"
        }
      }
    ]
  }
}
