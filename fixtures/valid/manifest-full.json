{
  "efsVersion": "1.0.0",
  "publisher": {
    "id": "urn:example:publishers:acme",
    "name": "Acme Example"
  },
  "factory": {
    "id": "customer-support",
    "name": "Customer Support Factory"
  },
  "release": {
    "version": "1.2.0",
    "digest": {
      "profile": "efs-jcs-sha256-v1",
      "algorithm": "SHA-256",
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    },
    "createdAt": "2026-11-16T05:30:00Z"
  },
  "capabilities": [
    {
      "id": "answer-customer",
      "name": "Answer customer",
      "contract": {
        "id": "https://schemas.example.org/contracts/customer-answer",
        "version": "1.0.0",
        "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
        "inputs": {
          "type": "object",
          "properties": {
            "question": {
              "type": "string"
            }
          },
          "required": [
            "question"
          ]
        },
        "outputs": {
          "type": "object",
          "properties": {
            "answer": {
              "type": "string"
            }
          },
          "required": [
            "answer"
          ]
        },
        "errors": [
          {
            "code": "INVALID_REQUEST",
            "description": "Invalid request",
            "schema": {
              "type": "object",
              "properties": {
                "reason": {
                  "type": "string"
                }
              }
            }
          }
        ],
        "guarantees": {
          "idempotency": "supported"
        }
      },
      "endpoints": [
        {
          "id": "invoke",
          "type": "invocation",
          "protocol": "https-json",
          "address": "https://api.example.org/factory/invoke"
        }
      ],
      "executionProfiles": [
        "standard"
      ]
    }
  ],
  "execution": {
    "source": "manifest",
    "profiles": [
      {
        "id": "standard",
        "modes": [
          "sync",
          "async",
          "streaming",
          "event"
        ]
      }
    ]
  },
  "dependencies": [
    {
      "id": "customer-records",
      "kind": "external",
      "target": {
        "id": "urn:example:services:customer-records"
      },
      "versionConstraint": "1.0.0",
      "required": true
    }
  ],
  "policies": {
    "declarations": [
      {
        "id": "tenant-access",
        "profile": "https://profiles.example.org/policies/access/v1",
        "version": "1.0.0",
        "content": {
          "mode": "restrictive"
        }
      }
    ],
    "references": [
      {
        "id": "https://policy.example.org/access",
        "profile": "https://profiles.example.org/policy/access/v1",
        "version": "1.0.0",
        "digest": {
          "algorithm": "SHA-256",
          "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        },
        "uri": "https://policy.example.org/artifacts/access/1.0.0",
        "enforcement": "mandatory"
      }
    ]
  }
}
