{
  "efsVersion": "1.0.0",
  "publisher": {
    "id": "urn:example:publishers:acme",
    "name": "Acme Example"
  },
  "factory": {
    "id": "contract-async",
    "name": "Async Contract Example"
  },
  "release": {
    "version": "1.2.0",
    "digest": {
      "profile": "efs-jcs-sha256-v1",
      "algorithm": "SHA-256",
      "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  },
  "capabilities": [
    {
      "id": "async-operation",
      "name": "async operation",
      "contract": {
        "id": "https://schemas.example.org/contracts/operation",
        "version": "1.0.0",
        "schemaDialect": "https://json-schema.org/draft/2020-12/schema",
        "inputs": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ],
          "additionalProperties": false
        },
        "outputs": {
          "type": "object",
          "properties": {
            "accepted": {
              "type": "boolean"
            }
          },
          "required": [
            "accepted"
          ],
          "additionalProperties": false
        },
        "errors": [
          {
            "code": "INVALID_REQUEST",
            "description": "The request does not satisfy the declared operation contract.",
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "message"
              ],
              "additionalProperties": false
            }
          }
        ],
        "guarantees": {}
      },
      "endpoints": [],
      "executionProfiles": [
        "profile-async"
      ]
    }
  ],
  "execution": {
    "source": "manifest",
    "profiles": [
      {
        "id": "profile-async",
        "modes": [
          "async"
        ]
      }
    ]
  },
  "dependencies": [],
  "policies": {
    "references": [
      {
        "id": "https://policy.example.org/access",
        "profile": "https://profiles.example.org/policy/access/v1",
        "version": "1.0.0",
        "digest": {
          "algorithm": "SHA-256",
          "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
        },
        "uri": "https://policy.example.org/artifacts/access/1.0.0",
        "enforcement": "mandatory"
      }
    ]
  }
}
