{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:psi-54-lifecycle:1",
  "title": "PSI-54 Registered Release Lifecycle Vector Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "version",
    "states",
    "legal_transitions",
    "vectors"
  ],
  "properties": {
    "vector_set": {
      "const": "psi-54-lifecycle-v1"
    },
    "version": {
      "const": "1.0.0"
    },
    "states": {
      "const": [
        "published",
        "suspended",
        "deprecated",
        "revoked",
        "archived"
      ]
    },
    "legal_transitions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    }
  },
  "$defs": {
    "state": {
      "enum": [
        "published",
        "suspended",
        "deprecated",
        "revoked",
        "archived"
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/state"
        },
        "to": {
          "$ref": "#/$defs/state"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "authorized",
        "reason_present",
        "evidence_present",
        "preconditions_met",
        "expected_revision_matches",
        "idempotency_replay"
      ],
      "properties": {
        "from": {
          "enum": [
            "published",
            "suspended",
            "deprecated",
            "revoked",
            "archived",
            "draft",
            "validated"
          ]
        },
        "to": {
          "enum": [
            "published",
            "suspended",
            "deprecated",
            "revoked",
            "archived",
            "draft",
            "validated"
          ]
        },
        "authorized": {
          "type": "boolean"
        },
        "reason_present": {
          "type": "boolean"
        },
        "evidence_present": {
          "type": "boolean"
        },
        "preconditions_met": {
          "type": "boolean"
        },
        "expected_revision_matches": {
          "type": "boolean"
        },
        "idempotency_replay": {
          "enum": [
            "none",
            "same_request",
            "different_request"
          ]
        }
      }
    },
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "scenario",
        "input",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^psi54-[a-z0-9-]+$"
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "$ref": "#/$defs/input"
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result",
            "reason"
          ],
          "properties": {
            "result": {
              "enum": [
                "accepted",
                "rejected"
              ]
            },
            "reason": {
              "enum": [
                "TRANSITION_ACCEPTED",
                "ILLEGAL_TRANSITION",
                "AUTHORIZATION_DENIED",
                "REASON_REQUIRED",
                "REVOCATION_EVIDENCE_REQUIRED",
                "PRECONDITION_FAILED",
                "STALE_REVISION",
                "IDEMPOTENT_REPLAY",
                "IDEMPOTENCY_CONFLICT"
              ]
            }
          }
        }
      }
    }
  }
}
