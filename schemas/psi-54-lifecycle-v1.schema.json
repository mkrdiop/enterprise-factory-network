{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:psi-54-lifecycle-v1:1",
  "title": "psi-54-lifecycle-v1 Conformance Vector Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "version",
    "states",
    "legal_transitions",
    "vectors"
  ],
  "properties": {
    "vector_set": {
      "const": "psi-54-lifecycle-v1"
    },
    "version": {
      "const": "1.1.0"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "required": [
              "operation",
              "scope",
              "request_fingerprint",
              "idempotency_lookup",
              "from",
              "to",
              "authorized",
              "reason_present",
              "evidence_present",
              "preconditions_met",
              "expected_revision_matches",
              "publication"
            ],
            "additionalProperties": true
          },
          "expected": {
            "type": "object",
            "required": [
              "result",
              "reason"
            ],
            "properties": {
              "result": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "states": {
      "const": [
        "published",
        "suspended",
        "deprecated",
        "revoked",
        "archived"
      ]
    },
    "legal_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    }
  }
}
