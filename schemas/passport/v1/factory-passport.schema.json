{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.enterprise-factory.network/passport/v1/factory-passport.schema.json",
  "title": "Enterprise Factory Factory Passport",
  "description": "Deterministic derived read model of one exact registry-verified EFS release. Not an identity, release, trust, certification or authorization authority.",
  "type": "object",
  "required": [
    "passportVersion",
    "source",
    "publisher",
    "factory",
    "release",
    "capabilities",
    "execution",
    "dependencies",
    "policies",
    "assurance",
    "provenance"
  ],
  "properties": {
    "passportVersion": {
      "const": "1.0"
    },
    "source": {
      "type": "object",
      "required": [
        "efsVersion",
        "publisherId",
        "factoryId",
        "releaseVersion",
        "digest",
        "registry"
      ],
      "properties": {
        "efsVersion": {
          "type": "string"
        },
        "publisherId": {
          "type": "string"
        },
        "factoryId": {
          "type": "string"
        },
        "releaseVersion": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "registry": {
          "type": "object",
          "required": [
            "releaseRecordId",
            "publishedAt",
            "artifactByteLength"
          ],
          "properties": {
            "releaseRecordId": {
              "type": "string",
              "format": "uuid"
            },
            "publishedAt": {
              "type": "string",
              "format": "date-time"
            },
            "artifactByteLength": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publisher": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "factory": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "release": {
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "contract",
          "endpoints"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "contract": {
            "type": "object",
            "required": [
              "id",
              "version",
              "schemaDialect",
              "inputs",
              "outputs",
              "errors"
            ]
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "executionProfiles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "execution": {
      "type": "object",
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "enum": [
            "manifest",
            "external"
          ]
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "profileReferences": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "policies": {
      "type": "object",
      "properties": {
        "declarations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "extensions": {
      "type": "object"
    },
    "assurance": {
      "type": "object",
      "required": [
        "artifactIntegrity",
        "publisherAuthentication",
        "publisherTrust",
        "signatureVerification",
        "authorization",
        "signatureMaterial"
      ],
      "properties": {
        "artifactIntegrity": {
          "const": "verified"
        },
        "publisherAuthentication": {
          "const": "not_evaluated"
        },
        "publisherTrust": {
          "const": "not_evaluated"
        },
        "signatureVerification": {
          "const": "not_evaluated"
        },
        "authorization": {
          "const": "not_evaluated"
        },
        "signatureMaterial": {
          "const": "not_part_of_digest_artifact"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "source",
          "sourcePointer",
          "rule"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^/"
          },
          "source": {
            "enum": [
              "manifest",
              "registry",
              "derivation"
            ]
          },
          "sourcePointer": {
            "type": "string",
            "pattern": "^/"
          },
          "rule": {
            "enum": [
              "copy",
              "count-items",
              "passport-contract-version",
              "verified-artifact-readback",
              "not-evaluated-by-registry",
              "excluded-from-digest-artifact",
              "count-endpoint-items"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "capabilityCount",
        "dependencyCount",
        "policyDeclarationCount",
        "policyReferenceCount",
        "endpointCount"
      ],
      "properties": {
        "capabilityCount": {
          "type": "integer",
          "minimum": 0
        },
        "dependencyCount": {
          "type": "integer",
          "minimum": 0
        },
        "policyDeclarationCount": {
          "type": "integer",
          "minimum": 0
        },
        "policyReferenceCount": {
          "type": "integer",
          "minimum": 0
        },
        "endpointCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": {
      "type": "object",
      "required": [
        "profile",
        "algorithm",
        "value"
      ],
      "properties": {
        "profile": {
          "const": "efs-jcs-sha256-v1"
        },
        "algorithm": {
          "const": "SHA-256"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      },
      "additionalProperties": false
    }
  }
}
