                                  "version": {
                                    "type": "string",
                                    "minLength": 1
                                  }
                                }
                              },
                              "executionProfileId": {
                                "type": "string",
                                "minLength": 1
                              },
                              "executionMode": {
                                "enum": [
                                  "sync",
                                  "async",
                                  "streaming",
                                  "event"
                                ]
                              }
                            }
                          },
                          "state": {
                            "enum": [
                              "created",
                              "requested",
                              "accepted",
                              "queued",
                              "running",
                              "waiting",
                              "succeeded",
                              "failed",
                              "cancelled"
                            ]
                          },
                          "revision": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "lastEventId": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "maxLength": 255
                          }
                        }
                      },
                      "persisted_with_intent": {
                        "const": true
                      },
                      "revision_cas": {
                        "const": true
                      }
                    }
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "result",
              "reason"
            ],
            "properties": {
              "result": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "PERMIT_ENFORCED",
                  "AUTHN_REQUIRED",
                  "ACTION_UNMAPPED",
                  "POLICY_DENIED",
                  "PDP_INDETERMINATE",
                  "OBLIGATION_UNFULFILLED",
                  "TRUST_UNAVAILABLE",
                  "KEY_NOT_TRUSTED",
                  "KEY_REVOKED",
                  "SIGNATURE_INVALID",
                  "RELEASE_NOT_ADMISSIBLE",
                  "EVIDENCE_STALE",
                  "AUDIT_DURABILITY_FAILURE",
                  "AUTHORIZATION_REVISION_CHANGED",
                  "EXECUTION_INTENT_NOT_DURABLE",
                  "EXECUTION_OUTCOME_UNKNOWN",
                  "INDETERMINATE_INVALID_ACTION_RESOURCE_PAIR",
                  "KEY_NOT_YET_VALID",
                  "KEY_EXPIRED"
                ]
              }
            }
          }
        }
      }
    }
  }
}
