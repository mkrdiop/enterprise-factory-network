{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:psi-53-enforcement-v1:1",
  "title": "psi-53-enforcement-v1 Conformance Vector Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "version",
    "vectors"
  ],
  "properties": {
    "vector_set": {
      "const": "psi-53-enforcement-v1"
    },
    "version": {
      "const": "1.1.0"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "required": [
              "principal",
              "checks",
              "trust",
              "lifecycle",
              "commit"
            ],
            "additionalProperties": false,
            "properties": {
              "principal": {
                "type": "object",
                "required": [
                  "authenticated",
                  "type",
                  "id",
                  "source"
                ],
                "properties": {
                  "authenticated": {
                    "type": "boolean"
                  },
                  "type": {
                    "type": "string"
                  },
                  "id": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  }
                }
              },
              "checks": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "action",
                    "resource",
                    "policy",
                    "pdp_outcome",
                    "obligations",
                    "obligations_fulfilled",
                    "fulfillment_evidence"
                  ],
                  "properties": {
                    "action": {
                      "type": "string",
                      "enum": [
                        "publisher.read",
                        "publisher.manage",
                        "factory.discover",
                        "factory.read",
                        "factory.register",
                        "factory.publish",
                        "release.read",
                        "release.publish",
                        "capability.invoke",
                        "registry.policy.read",
                        "registry.policy.manage",
                        "publisher.key.manage",
                        "release.suspend",
                        "release.deprecate",
                        "release.revoke",
                        "release.archive"
                      ]
                    },
                    "resource": {
                      "type": "object",
                      "required": [
                        "type",
                        "id",
                        "coordinates"
                      ],
                      "properties": {
                        "type": {
                          "type": "string",
                          "enum": [
                            "publisher",
                            "factory",
                            "release",
                            "capability",
                            "registry",
                            "execution_target"
                          ]
                        },
                        "id": {
                          "type": "string"
                        },
                        "coordinates": {
                          "type": "object"
                        }
                      }
                    },
                    "policy": {
                      "type": "object",
                      "required": [
                        "policy_id",
                        "policy_version",
                        "policy_profile",
                        "digest",
                        "digest_verified"
                      ],
                      "properties": {
                        "policy_id": {
                          "type": "string"
                        },
                        "policy_version": {
                          "type": "string"
                        },
                        "policy_profile": {
                          "const": "efs-policy-v1"
                        },
                        "digest": {
                          "type": "string",
                          "minLength": 43,
                          "maxLength": 43
                        },
                        "digest_verified": {
                          "type": "boolean"
                        }
                      }
                    },
                    "pdp_outcome": {
                      "enum": [
                        "permit",
                        "deny",
                        "indeterminate"
                      ]
                    },
                    "obligations": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "parameters": {
                            "type": "object"
                          }
                        }
                      }
                    },
                    "obligations_fulfilled": {
                      "type": "boolean"
                    },
                    "fulfillment_evidence": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "obligation_id",
                          "fulfilled",
                          "evidence_ref"
                        ],
                        "properties": {
                          "obligation_id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "fulfilled": {
                            "type": "boolean"
                          },
                          "evidence_ref": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              },
              "trust": {
                "type": "object",
                "required": [
                  "required",
                  "publisher_id",
                  "key_id",
                  "status",
                  "evidence",
                  "required_signers"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "publisher_id": {
                    "type": "string"
                  },
                  "key_id": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "trusted",
                      "untrusted",
                      "revoked",
                      "unavailable",
                      "not_required"
                    ]
                  },
                  "evidence": {
                    "type": [
                      "object",
                      "null"
                    ]
                  },
                  "required_signers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "publisher_id",
                        "key_id",
                        "algorithm",
                        "usage",
                        "crypto_status",
                        "status",
                        "evidence"
                      ],
                      "properties": {
                        "publisher_id": {
                          "type": "string"
                        },
                        "key_id": {
                          "type": "string"
                        },
                        "algorithm": {
                          "const": "Ed25519"
                        },
                        "usage": {
                          "const": "efs-release-signing"
                        },
                        "crypto_status": {
                          "enum": [
                            "valid",
                            "invalid",
                            "unavailable"
                          ]
                        },
                        "status": {
                          "enum": [
                            "trusted",
                            "untrusted",
                            "revoked",
                            "unavailable"
                          ]
                        },
                        "evidence": {
                          "oneOf": [
                            {
                              "type": "null"
                            },
                            {
                              "type": "object",
                              "required": [
                                "publisher_id",
                                "key_id",
                                "status",
                                "observed_at",
                                "expires_at",
                                "version"
                              ],
                              "properties": {
                                "publisher_id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "key_id": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "status": {
                                  "enum": [
                                    "trusted",
                                    "untrusted",
                                    "revoked"
                                  ]
                                },
                                "observed_at": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "expires_at": {
                                  "type": "string",
                                  "format": "date-time"
                                },
                                "version": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              }
                            }
                          ]
                        }
                      }
                    }
                  }
                }
              },
              "lifecycle": {
                "type": "object",
                "required": [
                  "required",
                  "state"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "not_release_operation",
                      "published",
                      "deprecated",
                      "suspended",
                      "revoked",
                      "archived",
                      "unknown"
                    ]
                  }
                }
              },
              "commit": {
                "type": "object",
                "required": [
                  "at",
                  "max_evidence_age_seconds",
                  "evidence_versions",
                  "current_evidence_versions",
                  "audit_outbox_available",
                  "operation_kind",
                  "side_effect"
                ],
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "max_evidence_age_seconds": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "evidence_versions": {
                    "type": "object"
                  },
                  "current_evidence_versions": {
                    "type": "object"
                  },
                  "audit_outbox_available": {
                    "type": "boolean"
                  },
                  "operation_kind": {
                    "type": "string"
                  },
                  "side_effect": {
                    "type": "object",
                    "required": [
                      "intent_durable",
                      "idempotency_key",
                      "dispatch_attempted",
                      "outcome_recorded",
                      "reconciled"
                    ],
                    "properties": {
                      "intent_durable": {
                        "type": "boolean"
                      },
                      "idempotency_key": {
                        "type": "string"
                      },
                      "dispatch_attempted": {
                        "type": "boolean"
                      },
                      "outcome_recorded": {
                        "type": "boolean"
                      },
                      "reconciled": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            }
          },
          "expected": {
            "type": "object",
            "required": [
              "result",
              "reason"
            ],
            "properties": {
              "result": {
                "type": "string"
              },
              "reason": {
                "type": "string",
                "enum": [
                  "PERMIT_ENFORCED",
                  "AUTHN_REQUIRED",
                  "ACTION_UNMAPPED",
                  "RESOURCE_COORDINATES_INVALID",
                  "ACTION_RESOURCE_MISMATCH",
                  "POLICY_DENIED",
                  "PDP_INDETERMINATE",
                  "OBLIGATION_UNFULFILLED",
                  "TRUST_UNAVAILABLE",
                  "KEY_NOT_TRUSTED",
                  "KEY_REVOKED",
                  "SIGNATURE_INVALID",
                  "RELEASE_NOT_ADMISSIBLE",
                  "EVIDENCE_STALE",
                  "AUDIT_DURABILITY_FAILURE",
                  "AUTHORIZATION_REVISION_CHANGED",
                  "EXECUTION_INTENT_NOT_DURABLE",
                  "EXECUTION_OUTCOME_UNKNOWN"
                ]
              }
            }
          }
        }
      }
    }
  }
}
