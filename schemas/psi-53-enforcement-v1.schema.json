{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:psi-53-enforcement-v1:1",
  "title": "psi-53-enforcement-v1 Conformance Vector Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "version",
    "vectors"
  ],
  "properties": {
    "vector_set": {
      "const": "psi-53-enforcement-v1"
    },
    "version": {
      "const": "1.1.0"
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scenario",
          "input",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object",
            "required": [
              "principal",
              "checks",
              "trust",
              "lifecycle",
              "commit"
            ],
            "additionalProperties": true
          },
          "expected": {
            "type": "object",
            "required": [
              "result",
              "reason"
            ],
            "properties": {
              "result": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
