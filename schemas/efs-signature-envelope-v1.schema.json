{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:signature-envelope:1",
  "title": "EFS v1 Detached Release Signature Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "profile_id",
    "statement",
    "signatures"
  ],
  "properties": {
    "envelope_version": {
      "const": "1"
    },
    "profile_id": {
      "const": "efs-ed25519-jcs-v1"
    },
    "statement": {
      "$ref": "#/$defs/statement"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/signer"
      }
    }
  },
  "$defs": {
    "statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "publisher_id",
        "factory_id",
        "release_version",
        "efs_version",
        "digest"
      ],
      "properties": {
        "purpose": {
          "const": "efs.release.signature.v1"
        },
        "publisher_id": {
          "type": "string",
          "minLength": 1,
          "format": "uri"
        },
        "factory_id": {
          "type": "string",
          "minLength": 1
        },
        "release_version": {
          "type": "string",
          "minLength": 1
        },
        "efs_version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "algorithm",
            "value"
          ],
          "properties": {
            "profile_id": {
              "const": "efs-jcs-sha256-v1"
            },
            "algorithm": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "algorithm",
        "signature"
      ],
      "properties": {
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "algorithm": {
          "const": "Ed25519"
        },
        "signature": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}
