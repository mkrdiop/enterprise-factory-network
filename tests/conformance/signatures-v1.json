            "profile_id": "efs-jcs-sha256-v1",
            "algorithm": "SHA-256",
            "value": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
          }
        },
        "signer": {
          "key_id": "release-2026-01",
          "algorithm": "Ed25519"
        }
      },
      "expected": {
        "jcs": "{\"domain\":\"efs.release.signature.v1\",\"signer\":{\"algorithm\":\"Ed25519\",\"key_id\":\"release-2026-01\"},\"statement\":{\"digest\":{\"algorithm\":\"SHA-256\",\"profile_id\":\"efs-jcs-sha256-v1\",\"value\":\"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"},\"efs_version\":\"1.0.0\",\"factory_id\":\"payments-risk\",\"publisher_id\":\"urn:example:publishers:acme\",\"purpose\":\"efs.release.signature.v1\",\"release_version\":\"1.4.2\"}}",
