    {
      "id": "sig-encoding-001",
      "kind": "encoding",
      "description": "Canonical 32-octet public-key Base64URL has 43 characters and zero unused pad bits.",
      "input": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA",
      "expected": {
        "decoded_octets": 32,
        "canonical": true
      }
    },
    {
      "id": "sig-encoding-002",
      "kind": "encoding",
      "description": "Reject non-zero unused pad bits in a 32-octet Base64URL value.",
      "input": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAB",
      "expected": {
        "canonical": false
      }
    },
    {
