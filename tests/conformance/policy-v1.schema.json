{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:policy-conformance-vectors:1",
  "title": "EFS policy v1 machine-readable conformance package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "specification",
    "policy_profile",
    "combining_algorithm",
    "base_request",
    "vectors",
    "validation_vectors",
    "policy_digest_handling"
  ],
  "properties": {
    "vector_set": {
      "const": "efs-policy-v1"
    },
    "specification": {
      "type": "string",
      "minLength": 1
    },
    "policy_profile": {
      "const": "efs-policy-v1"
    },
    "combining_algorithm": {
      "const": "deny-overrides-indeterminate-overrides-permit"
    },
    "base_request": {
      "type": "object",
      "required": [
        "subject",
        "resource",
        "action",
        "context"
      ],
      "properties": {
        "subject": {
          "type": "object"
        },
        "resource": {
          "type": "object"
        },
        "action": {
          "type": "string"
        },
        "context": {
          "type": "object"
        }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    },
    "validation_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationVector"
      }
    },
    "policy_digest_handling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "policy": {
          "type": "object"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "permutation_of": {
          "type": "string"
        },
        "combination": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition": {
          "type": "object"
        },
        "attribute": {
          "type": "object"
        },
        "resolver": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "validationVector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "evaluation_request",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "action-resource-compatibility"
            },
            "evaluation_request": {
              "$ref": "../schemas/efs-policy-v1.schema.json#/$defs/evaluationRequest"
            },
            "expected": {
              "const": {
                "classification": "invalid-input",
                "reason_code": "INVALID_ACTION_RESOURCE_COMBINATION"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "mutation",
            "value",
            "expected",
            "policy"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "invalid-policy"
            },
            "mutation": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            },
            "expected": {
              "const": "schema-invalid"
            },
            "policy": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "resource",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "invalid-resource"
            },
            "resource": {
              "type": "object"
            },
            "expected": {
              "const": "schema-invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "policy",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "semantic-policy"
            },
            "policy": {
              "type": "object"
            },
            "expected": {
              "const": {
                "classification": "semantic-invalid",
                "reason_code": "DUPLICATE_RULE_ID"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "limit",
            "expected",
            "condition"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "condition-limit"
            },
            "limit": {
              "enum": [
                "depth",
                "nodes",
                "children",
                "literal-array"
              ]
            },
            "expected": {
              "enum": [
                "reject-above-limit",
                "schema-invalid"
              ]
            },
            "condition": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "value",
            "expected",
            "attribute"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "timestamp-format"
            },
            "value": {
              "type": "string"
            },
            "expected": {
              "const": "schema-invalid"
            },
            "attribute": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "evaluation_time",
            "expires_at",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "freshness-boundary"
            },
            "evaluation_time": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "expected": {
              "const": "stale"
            }
          }
        }
      ]
    }
  }
}
