{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:policy-conformance-vectors:1",
  "title": "EFS policy v1 machine-readable conformance package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "specification",
    "policy_profile",
    "combining_algorithm",
    "base_request",
    "vectors",
    "validation_vectors",
    "policy_digest_handling"
  ],
  "properties": {
    "vector_set": {
      "const": "efs-policy-v1"
    },
    "specification": {
      "type": "string",
      "minLength": 1
    },
    "policy_profile": {
      "const": "efs-policy-v1"
    },
    "combining_algorithm": {
      "const": "deny-overrides-indeterminate-overrides-permit"
    },
    "base_request": {
      "type": "object",
      "required": [
        "subject",
        "resource",
        "action",
        "context"
      ],
      "properties": {
        "subject": {
          "type": "object"
        },
        "resource": {
          "type": "object"
        },
        "action": {
          "type": "string"
        },
        "context": {
          "type": "object"
        }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    },
    "validation_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationVector"
      }
    },
    "policy_digest_handling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "policy": {
          "type": "object"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "permutation_of": {
          "type": "string"
        },
        "combination": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition": {
          "type": "object"
        },
        "attribute": {
          "type": "object"
        },
        "resolver": {
          "type": "string"
        }
      }
    },
    "validationVector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "evaluation_request",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "action-resource-compatibility"
            },
            "evaluation_request": {
              "$ref": "#/$defs/evaluationRequest"
            },
            "expected": {
              "const": {
                "classification": "invalid-input",
                "reason_code": "INVALID_ACTION_RESOURCE_COMBINATION"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "mutation",
            "value",
            "expected",
            "policy"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "invalid-policy"
            },
            "mutation": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string"
            },
            "expected": {
              "const": "schema-invalid"
            },
            "policy": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "resource",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "invalid-resource"
            },
            "resource": {
              "type": "object"
            },
            "expected": {
              "const": "schema-invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "policy",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "semantic-policy"
            },
            "policy": {
              "type": "object"
            },
            "expected": {
              "const": {
                "classification": "semantic-invalid",
                "reason_code": "DUPLICATE_RULE_ID"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "limit",
            "expected",
            "condition"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "condition-limit"
            },
            "limit": {
              "enum": [
                "depth",
                "nodes",
                "children",
                "literal-array"
              ]
            },
            "expected": {
              "enum": [
                "reject-above-limit",
                "schema-invalid"
              ]
            },
            "condition": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "value",
            "expected",
            "attribute"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "timestamp-format"
            },
            "value": {
              "type": "string"
            },
            "expected": {
              "const": "schema-invalid"
            },
            "attribute": {
              "type": "object"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "evaluation_time",
            "expires_at",
            "expected"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "const": "freshness-boundary"
            },
            "evaluation_time": {
              "type": "string",
              "format": "date-time"
            },
            "expires_at": {
              "type": "string",
              "format": "date-time"
            },
            "expected": {
              "const": "stale"
            }
          }
        }
      ]
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 1024
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ]
    },
    "attributeRef": {
      "type": "string",
      "pattern": "^(subject\\.attributes|resource\\.coordinates|context\\.attributes)\\.[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "all"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              },
              "maxItems": 32
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "const": "any"
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/condition"
              },
              "maxItems": 32
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "arg"
          ],
          "properties": {
            "op": {
              "const": "not"
            },
            "arg": {
              "$ref": "#/$defs/condition"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "ref"
          ],
          "properties": {
            "op": {
              "const": "exists"
            },
            "ref": {
              "$ref": "#/$defs/attributeRef"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "ref",
            "value"
          ],
          "properties": {
            "op": {
              "const": "eq"
            },
            "ref": {
              "$ref": "#/$defs/attributeRef"
            },
            "value": {
              "$ref": "#/$defs/scalar",
              "maxLength": 1024
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "ref",
            "values"
          ],
          "properties": {
            "op": {
              "const": "in"
            },
            "ref": {
              "$ref": "#/$defs/attributeRef"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/scalar"
              },
              "maxItems": 64
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "ref",
            "value"
          ],
          "properties": {
            "op": {
              "enum": [
                "gt",
                "gte",
                "lt",
                "lte"
              ]
            },
            "ref": {
              "$ref": "#/$defs/attributeRef"
            },
            "value": {
              "type": "number"
            }
          }
        }
      ]
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "subjectSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "service_principal",
            "tenant",
            "publisher_principal"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?]+$"
        }
      }
    },
    "resourceSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "publisher",
            "factory",
            "release",
            "capability",
            "registry",
            "execution_target"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "publisher_id": {
              "type": "string",
              "minLength": 1
            },
            "factory_id": {
              "type": "string",
              "minLength": 1
            },
            "release_version": {
              "type": "string",
              "minLength": 1
            },
            "capability_id": {
              "type": "string",
              "minLength": 1
            },
            "registry_id": {
              "type": "string",
              "minLength": 1
            },
            "execution_target_id": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "publisher"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "required": [
                  "publisher_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "factory"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "required": [
                  "publisher_id",
                  "factory_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "release"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "required": [
                  "publisher_id",
                  "factory_id",
                  "release_version"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "required": [
                  "publisher_id",
                  "factory_id",
                  "release_version",
                  "capability_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "registry"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "required": [
                  "registry_id"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "execution_target"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "coordinates": {
                "required": [
                  "execution_target_id"
                ]
              }
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "effect",
        "subject",
        "resource",
        "actions"
      ],
      "properties": {
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "effect": {
          "enum": [
            "permit",
            "deny"
          ]
        },
        "subject": {
          "$ref": "#/$defs/subjectSelector"
        },
        "resource": {
          "$ref": "#/$defs/resourceSelector"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "publisher.read",
              "publisher.manage",
              "factory.discover",
              "factory.read",
              "factory.register",
              "factory.publish",
              "release.read",
              "release.publish",
              "capability.invoke",
              "registry.policy.read",
              "registry.policy.manage",
              "publisher.key.manage",
              "release.suspend",
              "release.deprecate",
              "release.revoke",
              "release.archive"
            ]
          }
        },
        "condition": {
          "$ref": "#/$defs/condition"
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "source",
        "observed_at",
        "expires_at"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/scalar"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "user",
            "service_principal",
            "tenant",
            "publisher_principal"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        }
      }
    },
    "resource": {
      "allOf": [
        {
          "$ref": "#/$defs/resourceSelector"
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "factory"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "coordinates"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "release"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "coordinates"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "capability"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "coordinates"
            ]
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_time",
        "attributes"
      ],
      "properties": {
        "evaluation_time": {
          "type": "string",
          "format": "date-time"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/attribute"
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_profile",
        "policy_id",
        "policy_version",
        "digest",
        "rules"
      ],
      "properties": {
        "policy_profile": {
          "const": "efs-policy-v1"
        },
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^*?]+$"
        },
        "policy_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile_id",
            "algorithm",
            "value"
          ],
          "properties": {
            "profile_id": {
              "const": "efs-policy-jcs-sha256-v1"
            },
            "algorithm": {
              "const": "sha-256"
            },
            "value": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{43}$"
            }
          }
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rule"
          }
        }
      }
    },
    "evaluationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "resource",
        "action",
        "context",
        "policies"
      ],
      "properties": {
        "subject": {
          "$ref": "#/$defs/subject"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        },
        "action": {
          "enum": [
            "publisher.read",
            "publisher.manage",
            "factory.discover",
            "factory.read",
            "factory.register",
            "factory.publish",
            "release.read",
            "release.publish",
            "capability.invoke",
            "registry.policy.read",
            "registry.policy.manage",
            "publisher.key.manage",
            "release.suspend",
            "release.deprecate",
            "release.revoke",
            "release.archive"
          ]
        },
        "context": {
          "$ref": "#/$defs/context"
        },
        "policies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/policy"
          }
        }
      }
    },
    "evaluationResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason_codes",
        "subject",
        "resource",
        "action",
        "policy_provenance",
        "matched_rule_ids",
        "obligations"
      ],
      "properties": {
        "decision": {
          "enum": [
            "permit",
            "deny",
            "indeterminate"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          }
        },
        "subject": {
          "$ref": "#/$defs/subjectSelector"
        },
        "resource": {
          "$ref": "#/$defs/resourceSelector"
        },
        "action": {
          "type": "string"
        },
        "policy_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "policy_id",
              "policy_version",
              "digest"
            ],
            "properties": {
              "policy_id": {
                "type": "string"
              },
              "policy_version": {
                "type": "string"
              },
              "digest": {
                "type": "string"
              }
            }
          }
        },
        "matched_rule_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/obligation"
          }
        }
      }
    }
  }
}
