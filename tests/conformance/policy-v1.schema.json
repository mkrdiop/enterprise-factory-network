{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:efs:schema:policy-conformance-vectors:1",
  "title": "EFS policy v1 machine-readable conformance package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vector_set",
    "specification",
    "policy_profile",
    "combining_algorithm",
    "base_request",
    "vectors",
    "validation_vectors",
    "policy_digest_handling"
  ],
  "properties": {
    "vector_set": {
      "const": "efs-policy-v1"
    },
    "specification": {
      "type": "string",
      "minLength": 1
    },
    "policy_profile": {
      "const": "efs-policy-v1"
    },
    "combining_algorithm": {
      "const": "deny-overrides-indeterminate-overrides-permit"
    },
    "base_request": {
      "type": "object",
      "required": [
        "subject",
        "resource",
        "action",
        "context"
      ],
      "properties": {
        "subject": {
          "type": "object"
        },
        "resource": {
          "type": "object"
        },
        "action": {
          "type": "string"
        },
        "context": {
          "type": "object"
        }
      }
    },
    "vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vector"
      }
    },
    "validation_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/validationVector"
      }
    },
    "policy_digest_handling": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "reason": {
          "type": "string"
        },
        "policy": {
          "type": "object"
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "permutation_of": {
          "type": "string"
        },
        "combination": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "condition": {
          "type": "object"
        },
        "attribute": {
          "type": "object"
        },
        "resolver": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "validationVector": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "expected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "action-resource-compatibility",
            "invalid-policy",
            "invalid-resource",
            "semantic-policy",
            "condition-limit",
            "timestamp-format",
            "freshness-boundary"
          ]
        },
        "action": {
          "type": "string"
        },
        "resource_type": {
          "type": "string"
        },
        "mutation": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "resource": {
          "type": "object"
        },
        "limit": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "evaluation_time": {
          "type": "string",
          "format": "date-time"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time"
        },
        "policy": {
          "type": "object"
        },
        "condition": {
          "type": "object"
        },
        "attribute": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
